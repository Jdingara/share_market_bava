# Copy this file to .env and fill it in. .env is gitignored - never commit it or share it.

# Kite Connect app (https://developers.kite.trade -> My apps). Set the app's redirect URL to https://127.0.0.1
KITE_API_KEY=
KITE_API_SECRET=

# Optional: phone alerts via Telegram. Create a bot with @BotFather, then get your chat id
# (message the bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
